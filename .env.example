SERVER_PORT=8080
# Comma-separated list of allowed origins (no "*" in production).
CORS_ALLOWED_ORIGINS=https://portfolio.cd04.fr
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USER=<proton-smtp-token-user>
SMTP_PASSWORD=<proton-smtp-token-password>
MAIL_FROM=contact@cd04.fr
MAIL_TO=codingdronecontact@proton.me
RATE_LIMIT_PER_MINUTE=5

SMTP_TIMEOUT_SECONDS=10
TIMEZONE=Europe/Paris
# Optional: name shown in the footer of POST /send emails
SITE_NAME=Portfolio

# Extra projects (POST /send/<id>) live in a JSON file, see config/sites.example.json
# SITES_FILE=/app/config/sites.json
